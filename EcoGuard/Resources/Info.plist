<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>청소 구역 사진을 찍어 오늘 청소를 인증하려면 카메라 접근이 필요해요.</string>
	<key>EcoWebAdminURL</key>
	<string>https://$(ECO_WEB_ADMIN_HOST)</string>
	<key>EcoAPIBaseURL</key>
	<string>https://$(ECO_API_HOST)</string>
	<key>EcoOAuthAuthorizeURL</key>
	<string>https://$(ECO_OAUTH_AUTHORIZE_HOST)</string>
	<key>EcoOAuthClientID</key>
	<string>$(ECO_OAUTH_CLIENT_ID)</string>
	<!-- dataGSM에 보내는 redirect_uri(서버 콜백). dataGSM 클라이언트·서버 설정과 글자까지 같아야 한다. -->
	<key>EcoOAuthRedirectURI</key>
	<string>$(ECO_OAUTH_REDIRECT_URI)</string>
	<!-- 서버가 인가 코드를 붙여 302로 돌려보내는 앱 주소. 커스텀 스킴은 ASWebAuthenticationSession에 스킴을 넘기므로 CFBundleURLTypes 등록이 필요 없다.
	     https로 바꾸려면 Associated Domains(webcredentials:)와 서버 apple-app-site-association이 있어야 하고 iOS 17.4부터 동작한다. -->
	<key>EcoOAuthCallbackURL</key>
	<string>$(ECO_OAUTH_CALLBACK_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>NotoSansKR-Regular.otf</string>
		<string>NotoSansKR-Medium.otf</string>
		<string>NotoSansKR-Bold.otf</string>
	</array>
</dict>
</plist>
